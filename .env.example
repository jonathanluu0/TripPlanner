# Which TripRepository implementation to use: 'local' (default, localStorage) | 'supabase'
VITE_BACKEND=local
# Supabase project (only needed when VITE_BACKEND=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Receipt parser: 'tesseract' (in-browser OCR, default) | 'claude' (server function) | 'manual'
VITE_RECEIPT_PARSER=tesseract
# Endpoint for the Claude receipt parser function (see server/parse-receipt)
VITE_RECEIPT_API_URL=
